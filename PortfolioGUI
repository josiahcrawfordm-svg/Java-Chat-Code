// PortfolioGUI.java
import javax.swing.*;
import javax.swing.event.*;
import java.awt.*;
import java.util.*;
public class PortfolioGUI extends JFrame implements Market.MarketListener{
    private final Portfolio portfolio;
    private final Market market;
    private final PortfolioPanel portfolioPanel;
    private final PortfolioGraphPanel graphPanel;
    private final StockTableModel tableModel;
    private final JTable stockTable;
    private StockDetailPanel detailPanel;
    private final SummaryPanel summaryPanel;

    public PortfolioGUI(Portfolio p, Market m){
        this.portfolio=p; this.market=m; market.addListener(this);
        setTitle("Trader Simulator"); setSize(1200,800); setLayout(new BorderLayout()); setDefaultCloseOperation(EXIT_ON_CLOSE);

        portfolioPanel=new PortfolioPanel(portfolio);
        add(portfolioPanel,BorderLayout.NORTH);

        graphPanel=new PortfolioGraphPanel(portfolio);
        add(graphPanel,BorderLayout.EAST);

        summaryPanel=new SummaryPanel(portfolio);
        add(summaryPanel,BorderLayout.SOUTH);

        tableModel=new StockTableModel(market.getStocks());
        stockTable=new JTable(tableModel); stockTable.setSelectionMode(ListSelectionModel.SINGLE_SELECTION);
        JScrollPane tableScroll=new JScrollPane(stockTable); tableScroll.setPreferredSize(new Dimension(400,600));
        add(tableScroll,BorderLayout.WEST);

        detailPanel=new StockDetailPanel(market.getStocks().get(0),portfolio);
        add(detailPanel,BorderLayout.CENTER);

        stockTable.getSelectionModel().addListSelectionListener(e->{
            if(!e.getValueIsAdjusting()){
                int row=stockTable.getSelectedRow();
                if(row>=0){
                    Stock s=tableModel.getStockAt(row);
                    remove(detailPanel);
                    detailPanel=new StockDetailPanel(s,portfolio);
                    add(detailPanel,BorderLayout.CENTER);
                    revalidate(); repaint();
                }
            }
        });

        setVisible(true);
    }

    @Override
    public void onPriceUpdate(Stock stock){
        SwingUtilities.invokeLater(()->{
            tableModel.refresh();
            detailPanel.refresh();
            portfolioPanel.refresh();
            graphPanel.updateHistory();
            summaryPanel.refresh();
        });
    }
}

