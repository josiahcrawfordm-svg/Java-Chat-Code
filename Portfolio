// Portfolio.java
import java.util.*;
import java.io.*;

public class Portfolio implements Serializable {
    private double cash;
    private final Map<Stock, Integer> holdings;
    private final List<String> tradeHistory;

    public Portfolio(double initialCash) {
        this.cash = initialCash;
        this.holdings = new LinkedHashMap<>();
        this.tradeHistory = new ArrayList<>();
    }

    public double getCash() { return cash; }
    public Map<Stock, Integer> getHoldings() { return holdings; }
    public List<String> getTradeHistory() { return tradeHistory; }

    public boolean buyStock(Stock stock, int quantity) {
        if (quantity <= 0) return false;
        double totalCost = stock.getPrice() * quantity;
        if (totalCost > cash) return false;
        cash -= totalCost;
        holdings.put(stock, holdings.getOrDefault(stock, 0) + quantity);
        tradeHistory.add(String.format("BUY %d %s at $%.2f", quantity, stock.getSymbol(), stock.getPrice()));
        return true;
    }

    public boolean sellStock(Stock stock, int quantity) {
        if (quantity <= 0) return false;
        int owned = holdings.getOrDefault(stock, 0);
        if (quantity > owned) return false;
        cash += stock.getPrice() * quantity;
        if (quantity == owned) holdings.remove(stock);
        else holdings.put(stock, owned - quantity);
        tradeHistory.add(String.format("SELL %d %s at $%.2f", quantity, stock.getSymbol(), stock.getPrice()));
        return true;
    }

    public double getTotalValue() {
        double total = cash;
        for (Map.Entry<Stock,Integer> e : holdings.entrySet()) {
            total += e.getKey().getPrice() * e.getValue();
        }
        return total;
    }

    public int getSharesOwned(Stock stock) {
        return holdings.getOrDefault(stock, 0);
    }

    // Save/load portfolio
    public void saveToFile(String filename) {
        try (ObjectOutputStream out = new ObjectOutputStream(new FileOutputStream(filename))) {
            out.writeObject(this);
        } catch(Exception e) { e.printStackTrace(); }
    }
    public static Portfolio loadFromFile(String filename) {
        try (ObjectInputStream in = new ObjectInputStream(new FileInputStream(filename))) {
            return (Portfolio) in.readObject();
        } catch(Exception e) { e.printStackTrace(); return null; }
    }
}
