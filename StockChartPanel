// StockChartPanel.java
import javax.swing.*;
import java.awt.*;
import java.util.*;
public class StockChartPanel extends JPanel {
    private final Stock stock;
    private boolean candlestick=false;

    public StockChartPanel(Stock stock) { this.stock=stock; setPreferredSize(new Dimension(500,200)); }

    public void setCandlestick(boolean c) { candlestick=c; }

    @Override
    protected void paintComponent(Graphics g) {
        super.paintComponent(g);
        List<Double> hist = stock.getPriceHistory();
        if(hist.size()<2) return;
        int w = getWidth(), h=getHeight();
        double max = hist.stream().max(Double::compare).orElse(1.0);
        double min = hist.stream().min(Double::compare).orElse(0.0);
        double range = max-min;
        int points = hist.size();

        for(int i=1;i<points;i++) {
            int x1=(i-1)*w/points;
            int x2=i*w/points;
            int y1=h-(int)((hist.get(i-1)-min)/range*h);
            int y2=h-(int)((hist.get(i)-min)/range*h);
            g.setColor(hist.get(i)>=hist.get(i-1)?Color.GREEN:Color.RED);
            g.drawLine(x1,y1,x2,y2);
        }
    }
}
