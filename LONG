import javax.swing.*;
import java.awt.*;
import java.util.*;

public class NewsTicker extends JPanel {

    private JLabel label = new JLabel();
    private List<String> headlines = new ArrayList<>();
    private int index = 0;

    public NewsTicker() {
        setLayout(new BorderLayout());
        add(label, BorderLayout.CENTER);
        generateHeadlines();
        nextHeadline();
    }

    public void nextHeadline() {
        label.setText(headlines.get(index));
        index = (index + 1) % headlines.size();
    }

    private void generateHeadlines() {
        for (int i = 1; i <= 70; i++) {
            headlines.add("Market Flash #" + i + " Investors react to economic data.");
        }
    }
}
