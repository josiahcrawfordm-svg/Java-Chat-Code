import javax.swing.*;
import java.awt.*;

public class TradeDialog extends JDialog {

    public TradeDialog(JFrame parent, Stock stock, Portfolio portfolio) {

        super(parent, "Trade " + stock.symbol, true);
        setSize(400, 350);
        setLayout(new GridLayout(8, 1));

        JLabel info = new JLabel(stock.symbol + " @ $" + String.format("%.2f", stock.price));

        JButton buy1 = new JButton("Buy 1");
        JButton buy5 = new JButton("Buy 5");
        JButton buy10 = new JButton("Buy 10");
        JButton buyAll = new JButton("Buy Max");

        JButton sellBtn = new JButton("Sell");
        JButton pinBtn = new JButton(stock.pinned ? "Unpin" : "Pin");

        buy1.addActionListener(e -> portfolio.placeMarketOrder(stock, 1, true));
        buy5.addActionListener(e -> portfolio.placeMarketOrder(stock, 5, true));
        buy10.addActionListener(e -> portfolio.placeMarketOrder(stock, 10, true));

        buyAll.addActionListener(e -> {
            int max = (int) (portfolio.cash / stock.price);
            portfolio.placeMarketOrder(stock, max, true);
        });

        sellBtn.addActionListener(e -> {
            String input = JOptionPane.showInputDialog("Sell how many?");
            if (input != null) {
                int qty = Integer.parseInt(input);
                portfolio.placeMarketOrder(stock, qty, false);
            }
        });

        pinBtn.addActionListener(e -> stock.pinned = !stock.pinned);

        add(info);
        add(buy1);
        add(buy5);
        add(buy10);
        add(buyAll);
        add(sellBtn);
        add(pinBtn);
    }
}
