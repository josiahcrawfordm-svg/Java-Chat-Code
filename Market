// Market.java
import java.util.*;
public class Market extends Thread {
    private final List<Stock> stocks = new ArrayList<>();
    private final List<MarketListener> listeners = new ArrayList<>();
    private boolean running = true;
    private final Random rand = new Random();

    public void addStock(Stock s) { stocks.add(s); }
    public List<Stock> getStocks() { return stocks; }
    public void addListener(MarketListener l) { listeners.add(l); }

    @Override
    public void run() {
        while(running) {
            try { Thread.sleep(5*60*1000); } catch(Exception e) {}
            for(Stock s: stocks) s.updatePrice();

            // Random market event
            if(rand.nextDouble()<0.1) {
                int affected = rand.nextInt(stocks.size()/2)+1;
                for(int i=0;i<affected;i++) {
                    Stock s = stocks.get(rand.nextInt(stocks.size()));
                    double adj = 1 + ((rand.nextDouble()-0.5)*0.4); // +/-20%
                    s.updatePrice();
                    s.updatePrice();
                }
            }

            for(MarketListener l: listeners) for(Stock s: stocks) l.onPriceUpdate(s);
        }
    }

    public void stopMarket() { running=false; }

    public interface MarketListener {
        void onPriceUpdate(Stock stock);
    }
}
