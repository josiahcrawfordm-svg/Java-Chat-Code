import java.util.*;

public class StockMarket {

    private List<Stock> stocks = new ArrayList<>();
    private Random rand = new Random();

    public void generateStocks() {

        String[][] data = {
                {"AAPL","Apple"},{"MSFT","Microsoft"},{"NVDA","Nvidia"},{"AMZN","Amazon"},
                {"META","Meta"},{"TSLA","Tesla"},{"NFLX","Netflix"},{"AMD","AMD"},
                {"INTC","Intel"},{"KO","CocaCola"},{"PEP","Pepsi"},{"DIS","Disney"},
                {"BA","Boeing"},{"WMT","Walmart"},{"JPM","JPMorgan"},{"V","Visa"},
                {"MA","Mastercard"},{"PFE","Pfizer"},{"MRNA","Moderna"},{"GE","GE"},
                {"CSCO","Cisco"},{"ORCL","Oracle"},{"IBM","IBM"},{"UBER","Uber"},
                {"SPOT","Spotify"}
        };

        for (int i = 0; i < data.length; i++) {
            double price = (i == 0) ? 400 : 10 + rand.nextDouble() * 190;
            stocks.add(new Stock(data[i][0], data[i][1], price));
        }
    }

    public void updatePrices() {
        for (Stock s : stocks) {
            double change = (rand.nextDouble() - 0.5) * 6;
            s.price += change;

            if (s.price < 5) s.price = 5;
            s.changePercent = change;
        }
    }

    public List<Stock> getStocks() {
        stocks.sort((a, b) -> Boolean.compare(b.pinned, a.pinned));
        return stocks;
    }

    public Stock getStock(String symbol) {
        return stocks.stream()
                .filter(s -> s.symbol.equals(symbol))
                .findFirst()
                .orElse(null);
    }
}
