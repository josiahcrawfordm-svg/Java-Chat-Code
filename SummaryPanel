// SummaryPanel.java
import javax.swing.*;
import java.awt.*;
public class SummaryPanel extends JPanel{
    private final Portfolio portfolio;
    private final JLabel topGainers,topLosers,largestHoldings;
    public SummaryPanel(Portfolio p){ portfolio=p;
        setLayout(new GridLayout(3,1));
        topGainers=new JLabel(); topLosers=new JLabel(); largestHoldings=new JLabel();
        add(topGainers); add(topLosers); add(largestHoldings);
    }
    public void refresh(){ 
        topGainers.setText("Top Gainers: ...");
        topLosers.setText("Top Losers: ...");
        largestHoldings.setText("Largest Holdings: ...");
    }
}
