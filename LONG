import java.io.Serializable;
import java.time.LocalDateTime;

public class Trade implements Serializable {

    String type;
    String symbol;
    int qty;
    double price;
    LocalDateTime time = LocalDateTime.now();

    public Trade(String type, String symbol, int qty, double price) {
        this.type = type;
        this.symbol = symbol;
        this.qty = qty;
        this.price = price;
    }

    public String toString() {
        return time.toLocalTime() + " " + type + " " + qty + " " + symbol + " @ $" + String.format("%.2f", price);
    }
}
