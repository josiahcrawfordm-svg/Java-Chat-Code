import java.io.Serializable;
import java.util.*;

public class Portfolio implements Serializable {

    public double cash;
    public Map<String, Integer> holdings = new HashMap<>();
    public List<Trade> tradeHistory = new ArrayList<>();
    public List<PendingOrder> pendingOrders = new ArrayList<>();
    private double startingCash;

    public Portfolio(double startingCash) {
        this.cash = startingCash;
        this.startingCash = startingCash;
    }

    public void placeMarketOrder(Stock stock, int qty, boolean buy) {
        if (qty <= 0) return;

        if (buy) {
            double cost = stock.price * qty;
            if (cash >= cost) {
                pendingOrders.add(new PendingOrder(stock.symbol, qty, true));
            }
        } else {
            int owned = holdings.getOrDefault(stock.symbol, 0);
            if (owned >= qty) {
                pendingOrders.add(new PendingOrder(stock.symbol, qty, false));
            }
        }
    }

    public void executePending(StockMarket market) {
        Iterator<PendingOrder> it = pendingOrders.iterator();

        while (it.hasNext()) {
            PendingOrder o = it.next();
            Stock s = market.getStock(o.symbol);
            if (s == null) continue;

            if (o.buy) {
                double cost = s.price * o.qty;
                if (cash >= cost) {
                    cash -= cost;
                    holdings.put(s.symbol, holdings.getOrDefault(s.symbol, 0) + o.qty);
                    tradeHistory.add(new Trade("BUY", s.symbol, o.qty, s.price));
                }
            } else {
                int owned = holdings.getOrDefault(s.symbol, 0);
                if (owned >= o.qty) {
                    cash += s.price * o.qty;
                    holdings.put(s.symbol, owned - o.qty);
                    tradeHistory.add(new Trade("SELL", s.symbol, o.qty, s.price));
                }
            }
            it.remove();
        }
    }

    public double getPortfolioValue(StockMarket market) {
        double value = cash;
        for (String sym : holdings.keySet()) {
            Stock s = market.getStock(sym);
            if (s != null) {
                value += holdings.get(sym) * s.price;
            }
        }
        return value;
    }

    public double getTotalPnL(StockMarket market) {
        return getPortfolioValue(market) - startingCash;
    }

    public int getShares(String symbol) {
        return holdings.getOrDefault(symbol, 0);
    }
}
