// Market.java
import java.util.List;
import java.util.ArrayList;

public class Market extends Thread {
    private final List<Stock> stocks = new ArrayList<>();
    private final List<MarketListener> listeners = new ArrayList<>();
    private boolean running = true;

    public void addStock(Stock stock) {
        stocks.add(stock);
    }

    public List<Stock> getStocks() {
        return stocks;
    }

    public void addListener(MarketListener listener) {
        listeners.add(listener);
    }

    @Override
    public void run() {
        while(running) {
            try { Thread.sleep(5 * 60 * 1000); } catch(InterruptedException e) {} // 5 minutes
            for(Stock s : stocks) {
                s.updatePrice();
                for(MarketListener l : listeners) l.onPriceUpdate(s);
            }
        }
    }

    public void stopMarket() {
        running = false;
    }

    public interface MarketListener {
        void onPriceUpdate(Stock stock);
    }
}
