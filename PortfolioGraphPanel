import javax.swing.*;
import java.awt.*;
import java.util.*;
public class PortfolioGraphPanel extends JPanel {
    private final Portfolio portfolio;
    private final java.util.List<Double> history = new ArrayList<>();
    public PortfolioGraphPanel(Portfolio p){ this.portfolio=p; setPreferredSize(new Dimension(400,200)); }
    public void updateHistory(){ history.add(portfolio.getTotalValue()); if(history.size()>50) history.remove(0); repaint(); }
    @Override
    protected void paintComponent(Graphics g){
        super.paintComponent(g);
        if(history.size()<2) return;
        int w=getWidth(),h=getHeight();
        double max=history.stream().max(Double::compare).orElse(1.0);
        double min=history.stream().min(Double::compare).orElse(0.0);
        double range=max-min;
        int pts=history.size();
        for(int i=1;i<pts;i++){
            int x1=(i-1)*w/pts; int x2=i*w/pts;
            int y1=h-(int)((history.get(i-1)-min)/range*h);
            int y2=h-(int)((history.get(i)-min)/range*h);
            g.setColor(history.get(i)>=history.get(i-1)?Color.GREEN:Color.RED);
            g.drawLine(x1,y1,x2,y2);
        }
    }
}
