import javax.swing.*;
import javax.swing.table.*;
import java.awt.*;
import java.awt.event.*;

public class TraderGUI extends JFrame {

    private StockMarket market;
    private Portfolio portfolio;
    private JTable table;
    private DefaultTableModel model;
    private JLabel cashLabel = new JLabel();
    private JLabel pnlLabel = new JLabel();
    private JTextArea historyArea = new JTextArea();

    public TraderGUI(StockMarket market, Portfolio portfolio) {
        this.market = market;
        this.portfolio = portfolio;

        setTitle("Trader Simulator");
        setSize(1100, 700);
        setLayout(new BorderLayout());

        model = new DefaultTableModel(new Object[]{"Symbol","Name","Price","Change %"}, 0);
        table = new JTable(model);
        table.setRowHeight(22);

        table.addMouseListener(new MouseAdapter() {
            public void mouseClicked(MouseEvent e) {
                if (e.getClickCount() == 2) {
                    int row = table.getSelectedRow();
                    Stock s = market.getStocks().get(row);
                    new TradeDialog(TraderGUI.this, s, portfolio).setVisible(true);
                }
            }
        });

        JScrollPane scroll = new JScrollPane(table);
        add(scroll, BorderLayout.CENTER);

        JPanel bottom = new JPanel(new GridLayout(1,3));
        bottom.add(cashLabel);
        bottom.add(pnlLabel);

        JButton saveBtn = new JButton("Save");
        saveBtn.addActionListener(e -> JOptionPane.showMessageDialog(this, "Saved (mock)"));
        bottom.add(saveBtn);

        add(bottom, BorderLayout.SOUTH);

        JScrollPane historyScroll = new JScrollPane(historyArea);
        historyScroll.setPreferredSize(new Dimension(300,0));
        add(historyScroll, BorderLayout.EAST);

        add(new NewsTicker(), BorderLayout.NORTH);

        new Timer(5000, e -> tick()).start();

        setVisible(true);
    }

    private void tick() {

        if (MarketHours.isMarketOpen()) {
            market.updatePrices();
            portfolio.executePending(market);
        }

        refreshTable();
        refreshPortfolio();
        refreshHistory();
    }

    private void refreshTable() {
        model.setRowCount(0);
        for (Stock s : market.getStocks()) {
            model.addRow(new Object[]{
                    s.symbol,
                    s.name,
                    String.format("$%.2f", s.price),
                    String.format("%.2f%%", s.changePercent)
            });
        }
    }

    private void refreshPortfolio() {
        cashLabel.setText("Cash: $" + String.format("%.2f", portfolio.cash));
        pnlLabel.setText("PnL: $" + String.format("%.2f", portfolio.getTotalPnL(market)));
    }

    private void refreshHistory() {
        historyArea.setText("");
        for (Trade t : portfolio.tradeHistory) {
            historyArea.append(t.toString() + "\n");
        }
    }
}
