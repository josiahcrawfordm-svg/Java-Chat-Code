import java.time.LocalTime;

public class MarketHours {

    public static boolean isMarketOpen() {
        LocalTime now = LocalTime.now();
        return now.isAfter(LocalTime.of(9, 30)) && now.isBefore(LocalTime.of(16, 0));
    }
}
